    "AdvancedTipMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For true global acceleration (open app / page switch / transition), inject AnimationSpeedTweak.dylib into SpringBoard via TrollFools, then Respring. The dylib reads this app config in real time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要实现真正的全局加速（开 App / 切页面 / 转场），请用 TrollFools 把 AnimationSpeedTweak.dylib 注入 SpringBoard 后注销。dylib 会实时读取本 App 配置。"
          }
        }
      }
    },
    "AdvancedTipTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Advanced Tip"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高级提示"
          }
        }
      }
    },
    "SpeedFooter": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower factor = faster. 0.01 = instant, 1.0 = normal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系数越小越快。0.01 = 瞬间，1.0 = 正常。"
          }
        }
      }
    },
    "SmartFooter": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smart scaling avoids ghosting on micro-animations."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能缩放可避免微动画出现残影。"
          }
        }
      }
    },
    "AdvancedFooter": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inject dylib for system-wide coverage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注入 dylib 可实现系统级覆盖。"
          }
        }
      }
